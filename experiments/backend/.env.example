PORT=3000
# Frontend origins allowed by CORS (comma separated), only needed if the website is NOT served by this server.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
# Session lifetime in hours
SESSION_TTL_HOURS=24
# SQLite file
DB_PATH=./data/logix.db
# Serve the website from this server too, so signup/login work on http://localhost:3000 without CORS.
# Path is relative to the folder you run `npm start` in (this layout: Logix/experiments/backend + Logix/experiments/frontend).
FRONTEND_DIR=../frontend

# Path to the compiled Logix compiler binary (build it with `make` in the Logix root).
# Default (if unset): Logix/logix
#LOGIX_BIN=/full/path/to/logix
